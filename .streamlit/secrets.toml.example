# The visitor enters their OWN API key in the sidebar, so this app needs NO secrets.
#
# LOCAL USE ONLY: copy to .streamlit/secrets.toml (git-ignored) to skip typing a key while you
# develop. A key here is used whenever the visitor types none, for the provider picked in the sidebar.
#
# Do NOT do this on a public app: st.secrets is shared by every visitor, so anyone could spend your credits.

# OPENROUTER_API_KEY = "sk-or-v1-..."   # OpenRouter key (default provider, serves DeepSeek models)

# DEEPSEEK_API_KEY = "sk-..."           # key from platform.deepseek.com (provider "DeepSeek (direct)")
# OPENAI_API_KEY = "sk-..."
